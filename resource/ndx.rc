#include <winver.h>

#define NDX_VER_MAJOR 1
#define NDX_VER_MINOR 0
#define NDX_VER_PATCH 0

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NDX_VER_MAJOR,NDX_VER_MINOR,NDX_VER_PATCH,0
 PRODUCTVERSION NDX_VER_MAJOR,NDX_VER_MINOR,NDX_VER_PATCH,0
