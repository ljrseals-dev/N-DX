            VALUE "CompanyName",      "Lewis Seals\0"
            VALUE "FileDescription",  "N-DX Neural Dynamics Engine (VST3)\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "NDX\0"
            VALUE "LegalCopyright",   "Copyright (c) Lewis Seals. VST is a trademark of Steinberg Media Technologies GmbH.\0"
            VALUE "OriginalFilename", "NDX.vst3\0"
            VALUE "ProductName",      "N-DX Neural Dynamics Engine\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
